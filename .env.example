# AtomS3からのPOSTリクエストを認証する共有シークレット (必須)
API_KEY=change-me-to-a-random-secret

# ダッシュボードへのログインパスワード (必須)
AUTH_PASSWORD=change-me-to-a-random-password

# ログインセッションCookieの署名に使う秘密鍵 (必須)
# 生成例: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-secret

# SQLiteファイルの保存先 (省略時は ./data/app.db)
# Railwayではボリュームのマウントパスを指定する (例: /data/app.db)
DB_PATH=./data/app.db

# LAN内の他端末(スマホ・AtomS3など)からdevサーバーにアクセスする場合のみ設定
# 自分のPCのLAN IPを指定する (例: 192.168.1.100)
DEV_LAN_IP=
